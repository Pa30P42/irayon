# =============================================================================
# DATABASE — leave empty in dev to keep the API on mock data.
# =============================================================================
#
# Local Postgres:
#   DATABASE_URL="postgresql://user:password@localhost:5432/irayon?schema=public"
#
# Supabase (recommended for production):
#   1. Create a project at https://supabase.com/dashboard
#   2. Project Settings → Database → Connection String
#   3. Pick "Transaction" pooler URL (port 6543) for runtime queries:
#      DATABASE_URL="postgres://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#   4. Pick "Session" / direct URL (port 5432) for migrations & seeding:
#      DIRECT_URL="postgres://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
#
# When DATABASE_URL is empty, the API falls back to in-memory mock data so the
# app keeps working in dev without any DB. Phase B: drop in the URLs and run
#   pnpm prisma:migrate
#   pnpm prisma:seed
DATABASE_URL=""
DIRECT_URL=""

# =============================================================================
# SUPABASE — required when DATABASE_URL is set. The service-role key bypasses
# RLS and is used by `src/lib/supabase-admin.ts` for storage uploads/deletes.
# NEVER prefix the service-role key with NEXT_PUBLIC_; it must stay server-only.
#
# Project Settings → API:
#   NEXT_PUBLIC_SUPABASE_URL    : `https://<project-ref>.supabase.co`
#   SUPABASE_SERVICE_ROLE_KEY   : the `service_role` secret (NOT `anon`)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# =============================================================================
# SITE URL — the public origin where the app is served. Drives canonical URLs,
# hreflang alternates, sitemap, robots.txt, and the production-domain SEO gate.
#
# Vercel envs:
#   Production : https://irayon.az
#   Preview    : https://irayon.vercel.app  (or the per-PR preview URL)
#   Development: http://localhost:3000      (or leave unset; localhost is the default)
#
# Anything other than `irayon.az` flips the SEO gate to "noindex everywhere"
# (robots.txt becomes Disallow: /, sitemap returns empty, page-level meta is
# noindex,nofollow). All SEO code stays in place — it just hibernates until
# the real domain is connected.
# =============================================================================
NEXT_PUBLIC_SITE_URL="https://irayon.az"

# Legacy alias — `NEXT_PUBLIC_SITE_URL` overrides this if both are set.
# Safe to remove once your local `.env` only uses NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# BREAK-GLASS ADMIN — the legacy credential login at /admin/login.
#
# Normal admin access is Google sign-in (below) with `role = admin`. This
# HMAC-cookie login is kept ONLY as break-glass: Google-only auth means an
# OAuth misconfiguration or a Google outage would otherwise lock the operator
# out of their own platform. It stores no password hashes and issues no user
# row — it just signs a cookie.
#
# It is OFF unless ADMIN_BREAK_GLASS=true. Leave it off in production and flip
# it on only for the duration of an incident. Every attempt (success AND
# failure) is logged as `admin_auth_failed` / `admin_break_glass_login`.
#
# ADMIN_SESSION_SECRET must be at least 32 characters (`openssl rand -base64 48`).
# =============================================================================
ADMIN_BREAK_GLASS="false"
ADMIN_LOGIN=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# =============================================================================
# AUTH.JS (NextAuth v5) — Google is the ONLY sign-in provider. No passwords
# exist anywhere in the system.
#
#   AUTH_SECRET       : `openssl rand -base64 32`. At least 32 chars. The
#                       middleware fails CLOSED (503) without it — a missing
#                       secret must never degrade into "everyone is anonymous
#                       but the gate opens anyway".
#   AUTH_GOOGLE_ID    : Google Cloud Console → APIs & Services → Credentials →
#   AUTH_GOOGLE_SECRET  OAuth 2.0 Client ID (type: Web application).
#                       Authorized redirect URI:
#                         https://<your-domain>/api/auth/callback/google
#                         http://localhost:3000/api/auth/callback/google
#   ADMIN_EMAIL       : the Google account that owns the platform. Used by
#                       `pnpm backfill:admin-host` to find the row to promote,
#                       and implicitly allowed to become a host.
#
# SKIPPABLE IN DEV: with AUTH_GOOGLE_ID/SECRET empty the Google button is
# hidden. Set AUTH_DEV_LOGIN=true to enable a development-only email sign-in
# that creates/uses a user row with no provider at all — enough to exercise
# the entire host/guest/booking flow before Google is connected. It is
# refused outright when NODE_ENV=production, regardless of this value.
# =============================================================================
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
ADMIN_EMAIL=""
AUTH_DEV_LOGIN="false"

# =============================================================================
# HOST SIGNUP GATE — account-scoped, not a plain boolean.
#
# A user may become a host when HOST_SIGNUP_ENABLED=true, OR when their email
# appears in HOST_SIGNUP_ALLOWLIST (comma-separated). ADMIN_EMAIL is always
# allowed. The allowlist exists so the full host flow can be verified against
# real production infrastructure while public host signup stays closed —
# opening it later is one env change on an already-exercised path.
# =============================================================================
HOST_SIGNUP_ENABLED="false"
HOST_SIGNUP_ALLOWLIST=""

# =============================================================================
# UPSTASH REDIS — durable rate limiting (`@upstash/ratelimit`, sliding window).
#
# SKIPPABLE: with both variables empty the limiter falls back to the in-memory
# per-instance Map. That is approximate (each warm lambda counts separately)
# but keeps dev, CI, and an un-provisioned deployment fully working.
#
# Create the database in the SAME region as the deployment — `ap-northeast-1`,
# matching the `hnd1` pin in vercel.json and the Supabase project. From another
# region a REST round-trip can cost more than the query it is protecting, which
# turns the session cache into a pessimisation that looks like an optimisation.
# https://console.upstash.com → Redis → Create database → REST API
# =============================================================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# =============================================================================
# EMAIL (Resend) — transactional notifications.
#
# Driver resolution: EMAIL_DRIVER ?? (RESEND_API_KEY ? "resend" : "log")
#
# SKIPPABLE: with no key the driver is `log` and every message is printed as a
# structured `email_logged` line instead of being sent. In PRODUCTION that
# resolution throws on the first send — a silently muted notification system is
# worse than a loud failure. Set EMAIL_DRIVER=log explicitly if you want to
# mute email on purpose (incident response); it just can't happen by omission.
#
#   RESEND_API_KEY : https://resend.com/api-keys
#   EMAIL_FROM     : a verified sender, e.g. "irayon <noreply@irayon.az>"
# =============================================================================
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_DRIVER=""

# =============================================================================
# SEARCH-ENGINE VERIFICATION — paste the token strings (NOT the full meta tag)
# from each console. Set in Vercel production only; previews/dev can stay empty.
#   Google Search Console : https://search.google.com/search-console
#     Property → Settings → Ownership verification → HTML tag → copy the
#     `content="…"` value into GOOGLE_SITE_VERIFICATION.
#   Yandex Webmaster      : https://webmaster.yandex.com
#     Add site → Meta tag → copy the `content="…"` value into
#     YANDEX_VERIFICATION.
# When empty the verification meta tag is omitted (no broken markup).
# =============================================================================
GOOGLE_SITE_VERIFICATION=""
YANDEX_VERIFICATION=""

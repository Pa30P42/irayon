generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Session-mode (port 5432) connection for migrate/seed/studio — those
  // don't work through Supabase's pgbouncer transaction pooler.
  directUrl = env("DIRECT_URL")
}

// Enum values are mapped to the kebab/lowercase forms used by the API DTOs,
// so the wire format is the same on both sides of the service boundary.

enum ListingCategory {
  MOUNTAIN @map("mountain")
  FOREST   @map("forest")
  RIVER    @map("river")
  SEA      @map("sea")
  LAKE     @map("lake")

  @@map("listing_category")
}

enum PlaceType {
  A_FRAME       @map("a-frame")
  VILLA_COTTAGE @map("villa-cottage")
  HOTEL         @map("hotel")
  MODULAR       @map("modular")
  VILLAGE_ROOM  @map("village-room")

  @@map("place_type")
}

enum Meal {
  BREAKFAST  @map("breakfast")
  ON_REQUEST @map("on-request")

  @@map("meal")
}

enum Activity {
  QUAD    @map("quad")
  HORSE   @map("horse")
  FISHING @map("fishing")

  @@map("activity")
}

enum ListingStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")

  @@map("listing_status")
}

model Region {
  id         String    @id @default(cuid())
  slug       String    @unique
  /// Localized name: { az: string, ru: string, en: string }
  name       Json
  coverImage String?
  /// Surfaced on homepage Regions grid when true.
  featured   Boolean   @default(false)
  sortOrder  Int       @default(0)
  villages   Village[]
  listings   Listing[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("regions")
}

model Village {
  id        String    @id @default(cuid())
  /// Slug unique per region (e.g. "laza" exists in both Gabala and Gusar).
  slug      String
  /// Localized name: { az, ru, en }
  name      Json
  regionId  String
  region    Region    @relation(fields: [regionId], references: [id], onDelete: Restrict)
  listings  Listing[]
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([regionId, slug])
  @@index([regionId])
  // Slug-only lookups (public filter modal / villages-by-slug) can't use the
  // composite [regionId, slug] unique — slug isn't its leading column.
  @@index([slug])
  @@map("villages")
}

model Amenity {
  id        String           @id @default(cuid())
  slug      String           @unique
  icon      String?
  /// Group key: essentials | outdoor | kitchen | family | extras
  category  String
  /// Localized name: { az, ru, en }
  name      Json
  listings  ListingAmenity[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([category])
  @@map("amenities")
}

model Listing {
  id          String            @id @default(cuid())
  slug        String            @unique
  /// Localized title: { az, ru, en }
  title       Json
  /// Localized description: { az, ru, en }
  description Json
  regionId    String
  region      Region            @relation(fields: [regionId], references: [id])
  villageId   String?
  village     Village?          @relation(fields: [villageId], references: [id], onDelete: SetNull)
  placeType   PlaceType
  /// Draft/publish/archive workflow. PUBLISHED is the default so existing
  /// rows (and the pre-status admin flow) keep their current visibility.
  status      ListingStatus     @default(PUBLISHED)
  /// One or more category tags. A listing can belong to multiple categories
  /// (e.g. a mountain forest cabin near a river).
  categories  ListingCategory[]
  price       Int
  rating      Float             @default(0)
  reviewCount Int               @default(0)
  capacity    Int
  bedrooms    Int
  lat         Float
  lng         Float
  address     String
  phone       String?
  meals       Meal[]
  activities  Activity[]
  /// Denormalized lowercase haystack for the `q` search: all three title
  /// locales + address, maintained by the service write paths (see
  /// `buildListingSearchText`). Backfilled + trigram-GIN-indexed in raw SQL
  /// (migration 20260806000200) — Prisma can't express gin_trgm_ops.
  searchText  String            @default("") @map("search_text")

  amenities  ListingAmenity[]
  images     Image[]
  callEvents CallEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categories], type: Gin)
  @@index([regionId])
  @@index([villageId])
  @@index([placeType])
  @@index([price])
  @@index([rating])
  @@index([createdAt])
  // Composite indexes for the actual buildWhere/buildOrderBy shapes: the
  // default catalogue scan (published, newest-first) and the hot
  // filter+sort combos — without these PG filters then sorts.
  @@index([status, createdAt(sort: Desc)])
  @@index([regionId, createdAt(sort: Desc)])
  @@index([placeType, createdAt(sort: Desc)])
  // Hero search filters on capacity (gte/lt/between).
  @@index([capacity])
  // `hasEvery` array queries on meals/activities translate to @> — GIN-able.
  @@index([meals], type: Gin)
  @@index([activities], type: Gin)
  @@map("listings")
}

model ListingAmenity {
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenityId String
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityId])
  @@index([amenityId])
  @@map("listing_amenities")
}

model Image {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  alt       String?
  createdAt DateTime @default(now())

  @@index([listingId, order])
  @@map("images")
}

/// One row per phone-CTA tap — the business's only conversion event.
/// `listingId` is SetNull (not Cascade) so deleting a listing keeps the
/// historical call volume.
model CallEvent {
  id        String   @id @default(cuid())
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  /// UI locale the tap happened in (az/ru/en); null for legacy clients.
  locale    String?
  /// Where the CTA lived: `detail` or `card`.
  source    String   @default("detail")
  createdAt DateTime @default(now())

  @@index([listingId, createdAt])
  @@index([createdAt])
  @@map("call_events")
}

/// Audit trail for state-changing admin actions. Read-only after insert;
/// queried via a forthcoming admin UI to investigate "who changed what".
/// `adminId` stays nullable through MVP1's single-admin model — once a User
/// table lands in MVP2 the column will carry the FK.
model AdminLog {
  id        String   @id @default(cuid())
  /// Stable verb describing the change: `listing.create`, `listing.update`,
  /// `listing.delete`, `region.create`, `village.delete`, …
  action    String
  /// Subject of the action — typically the affected row's id (cuid). Free
  /// text so it can carry a path like `listing/abc/image/xyz` when needed.
  target    String?
  /// Per-call detail blob. Use sparingly — never put PII or secrets here.
  metadata  Json?
  /// FK to a future User table. Nullable for now so MVP1 inserts don't fail.
  adminId   String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([target])
  @@map("admin_logs")
}
